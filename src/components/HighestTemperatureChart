import React from "react";

const HighestTemperatureChart = ({ history }) => {
  const records = Object.entries(history || {})
    .map(([key, value]) => {
      if (!value || typeof value !== "object") {
        return null;
      }

      const temp1 = Number(value.temp1);
      const temp2 = Number(value.temp2);

      const validTemp1 = Number.isFinite(temp1);
      const validTemp2 = Number.isFinite(temp2);

      if (!validTemp1 && !validTemp2) {
        return null;
      }

      const highest = Math.max(
        validTemp1 ? temp1 : -Infinity,
        validTemp2 ? temp2 : -Infinity
      );

      return {
        id: key,
        highest: highest,
        temp1: validTemp1 ? temp1 : null,
        temp2: validTemp2 ? temp2 : null,
      };
    })
    .filter(Boolean);

  const highestTemperature =
    records.length > 0
      ? Math.max(...records.map((item) => item.highest))
      : null;

  return (
    <div
      style={{
        background: "#ffffff",
        border: "1px solid #e5e7eb",
        borderRadius: "14px",
        padding: "24px",
        marginTop: "24px",
        marginBottom: "24px",
      }}
    >
      <div
        style={{
          color: "#6b7280",
          fontSize: "11px",
          fontWeight: "700",
          letterSpacing: "1px",
        }}
      >
        TEMPERATURE MONITORING
      </div>

      <h2
        style={{
          margin: "5px 0",
        }}
      >
        Highest Temperature Recorded
      </h2>

      <p
        style={{
          color: "#6b7280",
          fontSize: "13px",
          marginBottom: "20px",
        }}
      >
        Highest temperature between Temperature Sensor 1
        and Temperature Sensor 2.
      </p>

      {highestTemperature === null ? (
        <div
          style={{
            background: "#f8fafc",
            padding: "20px",
            borderRadius: "10px",
            color: "#6b7280",
          }}
        >
          No temperature history available yet.
        </div>
      ) : (
        <>
          <div
            style={{
              background: "#f8fafc",
              padding: "16px",
              borderRadius: "10px",
              marginBottom: "20px",
            }}
          >
            <div
              style={{
                color: "#6b7280",
                fontSize: "11px",
                fontWeight: "700",
              }}
            >
              HIGHEST RECORDED TEMPERATURE
            </div>

            <div
              style={{
                fontSize: "30px",
                fontWeight: "800",
                marginTop: "5px",
              }}
            >
              {highestTemperature.toFixed(2)} °C
            </div>
          </div>

          <div
            style={{
              overflowX: "auto",
              background: "#f8fafc",
              borderRadius: "10px",
              padding: "20px",
            }}
          >
            {records.map((item) => (
              <div
                key={item.id}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: "15px",
                  marginBottom: "12px",
                }}
              >
                <div
                  style={{
                    width: "90px",
                    fontSize: "12px",
                    color: "#6b7280",
                  }}
                >
                  {String(item.id).slice(-8)}
                </div>

                <div
                  style={{
                    flex: 1,
                    height: "24px",
                    background: "#e5e7eb",
                    borderRadius: "6px",
                    overflow: "hidden",
                  }}
                >
                  <div
                    style={{
                      width: `${Math.min(
                        Math.max(
                          (item.highest / highestTemperature) * 100,
                          0
                        ),
                        100
                      )}%`,
                      height: "100%",
                      background: "#f59e0b",
                      borderRadius: "6px",
                    }}
                  />
                </div>

                <div
                  style={{
                    width: "70px",
                    fontWeight: "700",
                    fontSize: "13px",
                  }}
                >
                  {item.highest.toFixed(2)} °C
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
};

export default HighestTemperatureChart;
